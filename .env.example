# Copiez ce fichier en .env et remplissez les valeurs réelles.
# .env ne doit JAMAIS être commité (voir .gitignore).

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# URL du déploiement Google Apps Script utilisé par le formulaire d'inscription
# (Inscription.jsx, ExpositionDigitale.jsx, Partenariats.jsx)
VITE_SHEET_URL_INSCRIPTIONS=

# URL du déploiement Google Apps Script utilisé par l'espace admin/facturation
# (AdminDashboard.jsx, generateFacture.js)
VITE_SHEET_URL_ADMIN=

# Mots de passe des espaces admin protégés par AdminGate.
# ATTENTION : ces variables VITE_* sont embarquées en clair dans le bundle JS
# livré au navigateur — elles ne constituent pas une vraie protection contre
# un attaquant qui inspecte le site en production. Voir la migration vers
# Supabase Auth pour une protection réelle.
VITE_ADMIN_PASSWORD=
VITE_PROFORMA_PASSWORD=
VITE_SONDAGES_PASSWORD=
VITE_DIAGNOSTIC_PASSWORD=
